APP_ENV=development
DATA_MODE=github
CORS_ORIGINS=http://localhost:5173

# Optional server-side fallback. Interactive onboarding sends a fine-grained token per request.
GITHUB_TOKEN=
# Required only for GitHub App/repository webhook delivery verification.
GITHUB_WEBHOOK_SECRET=

# Enables scan/event persistence while DATA_MODE remains github.
SNOWFLAKE_PERSISTENCE_ENABLED=false
# Required when persistence is enabled or DATA_MODE=snowflake. Never commit real credentials.
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USER=your_service_user
SNOWFLAKE_PRIVATE_KEY_FILE=/absolute/path/to/snowflake_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=INGESTION_ROLE
SNOWFLAKE_WAREHOUSE=INGEST_WH
SNOWFLAKE_DATABASE=SUPPLY_CHAIN_MONITOR
SNOWFLAKE_SCHEMA=DETECTION
