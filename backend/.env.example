APP_ENV=development
DATA_MODE=mock
CORS_ORIGINS=http://localhost:5173

# Optional in mock mode. Use a fine-grained, read-only token for live GitHub analysis.
GITHUB_TOKEN=

# Required only when DATA_MODE=snowflake. Never commit real credentials or key files.
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USER=your_service_user
SNOWFLAKE_PRIVATE_KEY_FILE=/absolute/path/to/snowflake_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=DASHBOARD_ROLE
SNOWFLAKE_WAREHOUSE=HACKATHON_WH
SNOWFLAKE_DATABASE=SUPPLY_CHAIN_MONITOR
SNOWFLAKE_SCHEMA=DETECTION
